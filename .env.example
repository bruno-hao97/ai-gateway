GOMMO_AUTH_BASE_URL=https://api.gommo.net
GOMMO_AUTH_PATH=/api/apps/go-mmo
GOMMO_API_DOMAIN=79ai.net

# Merchant/admin — server-only, KHÔNG expose ra browser hay /gateway
GOMMO_ACCESS_TOKEN=nIojqp6eR4t2UsFKyZMLQsLrYFTP73mRr7sOeufvyMZQ/pDpeCBWFRWe4bPMCTVEdWsCpSTnnLhhxZV1kaHYW7ktK4Z2Xqha41gdj+gJJKt4ZsP2BApe7xMnwJrOachAtvTFPsgmUu6dfSmsXh9CBAOE7F2GNoWGBw/w/vdvH5riY2e8bntHTo3SD/R6GgJRa2B8PytFkaGMbENLirnnvw==
GOMMO_MANAGER_ID=c8f06b2317880f42
GOMMO_REGISTER_EXPIRED_TIME=999
TOPUP_MERCHANT_BUFFER_CREDITS=300000
ADMIN_API_KEY=

# PayOS billing (/billing — tách khỏi /gateway)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL public webhook — đăng ký trên my.payos.vn
# PAYOS_WEBHOOK_URL=https://api.yourdomain.com/billing/webhook/payos
# PAYOS_RETURN_URL=http://localhost:3001/portal/
# PAYOS_CANCEL_URL=http://localhost:3001/portal/
# APP_URL=http://localhost:3001
# TOPUP_ORDERS_FILE=./data/topup-orders.json
# TOPUP_CREDITS_PER_VND=1

# Chat defaults (POST /gateway/chat)
GOMMO_CHAT_AGENT_ID=560ee19d40623da6851a1bd0af0930dd
GOMMO_CHAT_SERVER=cheap
GOMMO_CHAT_MODEL=gpt-5.5::cheap
GOMMO_CHAT_PROJECT_ID=default

# Server (Railway/Fly/Docker tự set PORT)
PORT=3001

# Production — CORS cho browser client khác origin (comma-separated)
# Không cần nếu chỉ gọi API từ server hoặc dùng /portal same-origin
# GATEWAY_CORS_ORIGIN=https://your-frontend.example.com

# Dev portal tại /portal — tắt production mặc định; bật: GATEWAY_PORTAL=true
# GATEWAY_PORTAL=false,https://docs.yourdomain.com

# Rate limit (optional — defaults: gateway 120/min, admin 30/min per IP)
# GATEWAY_RATE_LIMIT_WINDOW_MS=60000
# GATEWAY_RATE_LIMIT_MAX=120
# ADMIN_RATE_LIMIT_MAX=30

# Catalog EN descriptions (shared cache: gateway + docs + portal)
# Runtime: reads cache/catalog-descriptions.en.json only (no external API by default).
# CATALOG_DESCRIPTION_CACHE_FILE=./cache/catalog-descriptions.en.json
# CATALOG_TRANSLATE_ON_REQUEST=false
#
# Warm cache once (dev/CI), then commit cache/catalog-descriptions.en.json:
#   GOMMO_ACCESS_TOKEN=...        # uses Gommo chat — no OpenRouter key needed
#   npm run catalog:translate
# Optional: CATALOG_TRANSLATE_BATCH_SIZE=25
# Optional fallback: OPENROUTER_API_KEY=sk-or-... (only if no GOMMO_ACCESS_TOKEN)
# Set CATALOG_TRANSLATE_ON_REQUEST=true only if you want live translate on cache miss.
