{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "client:build": "npm run build --workspace=@ai-gateway/client",
    "client:test": "npm run test --workspace=@ai-gateway/client",
    "theme:test": "node --import tsx --test \"docs/.vitepress/theme/models/*.test.ts\"",
    "portal:smoke": "node scripts/portal-smoke-http.mjs",
    "test:aggregate": "node --import tsx --test src/services/usageAggregateCache.test.ts",
    "client:publish": "npm publish --workspace=@ai-gateway/client --access public",
    "portal:sync": "node scripts/sync-portal-to-docs.mjs",
    "docs:dev": "vitepress dev docs --port 5173",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:stack": "npx --yes concurrently -n api,docs -c blue,green \"npm run dev\" \"npm run docs:dev\"",
    "predocs:build": "npm run portal:sync",
    "catalog:translate": "tsx scripts/catalog-translate.ts",
    "billing:verify": "tsx scripts/billing-verify-packages.ts",
    "portal:dev": "npx --yes serve apps/docs-portal -l 5180",
    "mcp:build": "npm run build --workspace=@ai-gateway/mcp-server",
    "mcp:start": "npm run start --workspace=@ai-gateway/mcp-server"
  },
  "dependencies": {
    "@ai-gateway/client": "^0.1.0",
    "@payos/node": "^2.0.5",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3"
  }
}
